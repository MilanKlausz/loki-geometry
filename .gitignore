# Ignore everything by default...
*

# ...but keep directories traversable so nested files can be tracked
!*/

# Track the package (sources and data), tests, packaging files and this file
!*.py
!src/loki_geometry/data/*.txt
!pyproject.toml
!README.md
!LICENSE
!.gitignore

# Local, non version controlled material (documents, large JSON files, raw
# survey data, ...): any directory whose name ends in _local
*_local/

# Build and cache directories
__pycache__/
build/
dist/
*.egg-info/
